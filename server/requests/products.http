@baseUrl = http://localhost:3001
@accessToken = 
@otherAccessToken = 
@productId = fc8fe453-1a13-4ae4-b22d-064a574816fb
@deleteProductId = 30198e48-f91b-4948-a675-196c6864ab9f

### 상품 목록 조회 - 비로그인
GET {{baseUrl}}/products?page=1&pageSize=10&orderBy=recent

### 상품 목록 조회 - 로그인
GET {{baseUrl}}/products?page=1&pageSize=10&orderBy=recent
Authorization: Bearer {{accessToken}}

### 상품 등록 - 비로그인
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "뉴질랜드 공기",
  "description": "비닐봉지에 담아드립니다.",
  "price": 300000,
  "tags": ["공기", "포장", "해외직구"]
}

### 상품 등록 - 잘못된 데이터
POST {{baseUrl}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "",
  "description": "상품 설명.",
  "price": 30000
}

### 상품 등록 - 정상
POST {{baseUrl}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "무한한 용기",
  "description": "용기를 드립니다!",
  "price": 500000,
  "tags": ["진품", "포장", "필수품"]
}

### 상품 목록 조회 - 검색
GET {{baseUrl}}/products?page=1&pageSize=10&keyword=뉴질랜드&orderBy=recent

### 상품 목록 조회 - 검색 결과 없음
GET {{baseUrl}}/products?page=1&pageSize=10&keyword=호주&orderBy=recent

### 상품 상세 조회 - 정상
GET {{baseUrl}}/products/{{productId}}

### 상품 상세 조회 - 존재하지 않는 상품
GET {{baseUrl}}/products/111111

### 상품 댓글 등록 - 비로그인
POST {{baseUrl}}/products/{{productId}}/comments
Content-Type: application/json

{
  "content": "진짜 뉴질랜드 공기인가요?"
}

### 상품 댓글 등록 - 빈 댓글
POST {{baseUrl}}/products/{{productId}}/comments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "    "
}

### 상품 댓글 등록 - 정상
POST {{baseUrl}}/products/{{productId}}/comments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "진짜 뉴질랜드 공기인가요?"
}

### 상품 댓글 목록 - 기본 10개
GET {{baseUrl}}/products/{{productId}}/comments

### 상품 댓글 목록 - 1개씩 조회
GET {{baseUrl}}/products/{{productId}}/comments?limit=1

### 상품 댓글 목록 - 잘못된 limit
GET {{baseUrl}}/products/{{productId}}/comments?limit=abc

### 상품 수정 - 비로그인
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json

{
  "price": 250000
}

### 상품 수정 - 잘못된 데이터
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": ""
}

### 상품 수정 - 존재하지 않는 상품
PATCH {{baseUrl}}/products/11111
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": 250000
}

### 상품 수정 - 작성자 본인
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "price": 250000,
  "tags" : ["세일"]
}

### 상품 수정 - 다른 사용자
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{otherAccessToken}}
Content-Type: application/json

{
  "price": 100
}

### 상품 삭제 - 비로그인
DELETE {{baseUrl}}/products/{{productId}}

### 상품 삭제 - 다른 사용자
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{otherAccessToken}}

### 상품 삭제 - 존재하지 않는 상품
DELETE {{baseUrl}}/products/11111
Authorization: Bearer {{accessToken}}

### 상품 삭제 - 작성자 본인
DELETE {{baseUrl}}/products/{{deleteProductId}}
Authorization: Bearer {{accessToken}}

### 상품 좋아요 - 비로그인
POST {{baseUrl}}/products/{{productId}}/likes

### 상품 좋아요 - 존재하지 않는 상품
POST {{baseUrl}}/products/111111/likes
Authorization: Bearer {{accessToken}}

### 상품 좋아요 - 정상
POST {{baseUrl}}/products/{{productId}}/likes
Authorization: Bearer {{accessToken}}

### 상품 좋아요 취소 - 비로그인
DELETE {{baseUrl}}/products/{{productId}}/likes

### 상품 좋아요 취소 - 존재하지 않는 상품
DELETE {{baseUrl}}/products/11111/likes
Authorization: Bearer {{accessToken}}

### 상품 좋아요 취소 - 정상
DELETE {{baseUrl}}/products/{{productId}}/likes
Authorization: Bearer {{accessToken}}
