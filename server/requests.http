@baseUrl = http://localhost:3000

### 상품 등록
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Keyboard",
  "description": "Mechanical keyboard",
  "price": 120000,
  "tags": ["keyboard", "electronics"]
}

### 상품 목록 조회
GET {{baseUrl}}/products

### 상품 목록 조회 - 페이지네이션
GET {{baseUrl}}/products?offset=0&limit=40

### 상품 검색 - keyword
GET {{baseUrl}}/products?keyword=인형


### 상품 최신순
GET {{baseUrl}}/products?orderBy=recent

### 상품 상세 조회
@productId = 6803b431-700b-4191-b703-6bb118871d2c
GET {{baseUrl}}/products/{{productId}}

### 상품 수정
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json

{
  "price": 18000,
  "name": "쵸소우 치미케모"
}

### 상품 삭제
DELETE {{baseUrl}}/products/{{productId}}

### 없는 상품 조회 에러 테스트
GET {{baseUrl}}/products/00000000-0000-0000-0000-000000000000


### 게시글 등록
POST {{baseUrl}}/articles
Content-Type: application/json

{
  "title": "첫 번째 게시글",
  "content": "자유게시판 내용입니다."
}

### 게시글 목록 조회
GET {{baseUrl}}/articles

### 게시글 목록 조회 - 페이지네이션
GET {{baseUrl}}/articles?offset=0&limit=10

### 게시글 검색
GET {{baseUrl}}/articles?keyword=첫

### 게시글 최신순
GET {{baseUrl}}/articles?orderBy=recent

### 게시글 상세 조회
@articleId = 5d22837a-1b10-4462-bee4-471cab259403
GET {{baseUrl}}/articles/{{articleId}}

### 게시글 수정
PATCH {{baseUrl}}/articles/{{articleId}}
Content-Type: application/json

{
  "title": "수정된 제목",
  "content": "수정된 내용입니다."
}

### 게시글 삭제
DELETE {{baseUrl}}/articles/{{articleId}}

### 없는 게시글 조회
GET {{baseUrl}}/articles/00000000-0000-0000-0000-000000000000


### 중고마켓 댓글 등록
@productId = 6803b431-700b-4191-b703-6bb118871d2c
POST {{baseUrl}}/products/{{productId}}/comments
Content-Type: application/json

{
  "content": "상품 댓글입니다."
}

### 중고마켓 댓글 목록 조회
GET {{baseUrl}}/products/{{productId}}/comments?limit=10

### 중고마켓 댓글 목록 조회 - cursor
@productCommentCursor = 여기에_마지막_댓글_id_붙여넣기
GET {{baseUrl}}/products/{{productId}}/comments?cursor={{productCommentCursor}}&limit=10

### 중고마켓 댓글 수정
@productCommentId = 여기에_product_comment_id_붙여넣기
PATCH {{baseUrl}}/product-comments/{{productCommentId}}
Content-Type: application/json

{
  "content": "수정된 상품 댓글입니다."
}

### 중고마켓 댓글 삭제
DELETE {{baseUrl}}/product-comments/{{productCommentId}}


### 자유게시판 댓글 등록
@articleId = 여기에_article_id_붙여넣기
POST {{baseUrl}}/articles/{{articleId}}/comments
Content-Type: application/json

{
  "content": "게시글 댓글입니다."
}

### 자유게시판 댓글 목록 조회
GET {{baseUrl}}/articles/{{articleId}}/comments?limit=10

### 자유게시판 댓글 목록 조회 - cursor
@articleCommentCursor = 여기에_마지막_댓글_id_붙여넣기
GET {{baseUrl}}/articles/{{articleId}}/comments?cursor={{articleCommentCursor}}&limit=10

### 자유게시판 댓글 수정
@articleCommentId = 여기에_article_comment_id_붙여넣기
PATCH {{baseUrl}}/article-comments/{{articleCommentId}}
Content-Type: application/json

{
  "content": "수정된 게시글 댓글입니다."
}

### 자유게시판 댓글 삭제
DELETE {{baseUrl}}/article-comments/{{articleCommentId}}