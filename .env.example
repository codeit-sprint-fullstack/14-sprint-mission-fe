# 프론트가 바라볼 API 주소 (Express 서버: npm run server)
API_BASE_URL = "http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL = "http://localhost:4000"

# PostgreSQL 접속 문자열 (비밀번호에 특수문자 있으면 URL 인코딩)
DATABASE_URL="postgresql://postgres:password@localhost:5432/panda_market?schema=public"

# JWT — 시크릿은 아래 명령으로 생성해서 채우기
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_EXPIRES="14d"

# Google OAuth — console.cloud.google.com 에서 OAuth 2.0 Client ID(Web) 발급
# "승인된 JavaScript 원본"에 http://localhost:3000 추가 후 Client ID 붙여넣기
# (앞/뒤 값은 같은 Client ID)
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""