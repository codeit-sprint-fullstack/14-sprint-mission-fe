model Article {
  id String @id @default(uuid())
  title String
  content String 
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Comment {
  id String @id
  content String 
  createdAt DateTime @default(now())
  updatedAt DateTime
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
